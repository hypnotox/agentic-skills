{
  "name": "agentic-skills",
  "version": "0.1.0",
  "description": "Repository-agnostic engineering skills and role prompts for Claude Code and Pi.",
  "license": "AGPL-3.0-only",
  "author": "Josua Müller <hypnotox@pm.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hypnotox/agentic-skills.git"
  },
  "type": "module",
  "files": [
    ".claude-plugin",
    "agents",
    "extensions",
    "skills",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "keywords": [
    "agent-skills",
    "claude-code-plugin",
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && claude plugin validate --strict .claude-plugin/plugin.json && claude plugin validate --strict skills && claude plugin validate --strict agents && claude plugin validate --strict .claude-plugin/marketplace.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "20.19.37",
    "pi-tools": "https://github.com/hypnotox/pi-tools/archive/refs/tags/v0.3.0.tar.gz",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-subagents/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
