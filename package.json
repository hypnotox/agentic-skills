{
  "name": "agentic-skills",
  "version": "0.1.0",
  "description": "Repository-agnostic engineering and creative skills and role prompts for Claude Code, Codex, and Pi.",
  "license": "AGPL-3.0-only",
  "author": "Josua Müller <hypnotox@pm.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hypnotox/agentic-skills.git"
  },
  "type": "module",
  "files": [
    ".agents/plugins",
    ".claude-plugin",
    "plugin.json",
    "agents",
    "codex/agents",
    "skills",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "keywords": [
    "agent-skills",
    "claude-code-plugin",
    "codex-plugin",
    "pi-package"
  ],
  "scripts": {
    "generate": "node scripts/generate-agents.ts",
    "generate:check": "node scripts/generate-agents.ts --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run generate:check && npm run typecheck && npm test && claude plugin validate . && claude plugin validate --strict skills && claude plugin validate --strict agents"
  },
  "devDependencies": {
    "@types/node": "*",
    "smol-toml": "*",
    "typescript": "*",
    "vitest": "*",
    "yaml": "*"
  },
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "pi-subagents": {
    "agents": [
      "./agents"
    ]
  }
}
